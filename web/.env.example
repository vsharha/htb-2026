# Copy to .env.local and fill in. .env.local is ignored by Git.

# Local Clef decision model (Cloudflare, Jev/SystemOne-compatible) used for
# audience scoring. Point this at a self-hosted /v1/systemone endpoint (for
# example clef-flash served by llama.cpp, SGLang or vLLM on the deployed
# cloud). Scoring falls back to keyword matching and the Customers tab says so
# when the endpoint can't be reached.
CLEF_BASE_URL=http://127.0.0.1:30000
CLEF_MODEL=clef-flash
# Optional bearer token, for a hosted/protected Clef endpoint.
CLEF_API_TOKEN=

# OpenAI API key, for live competitor research with web search and page reading.
# Missing or rejected credentials leave competition coverage unknown.
OPENAI_API_KEY=
