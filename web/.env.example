# Copy to .env.local and fill in. .env.local is ignored by Git.

# Which decision model audience scoring uses: leave unset or "jev" for Jev
# through AI Gateway (the local demo), or "systemone" to use the self-hosted
# model below. Without "systemone" the self-hosted endpoint is never tried.
AUDIENCE_MODEL=jev

# Self-hosted System One decision model, run on Vultr Cloud Compute by
# `infra/vultr`. It speaks the same /v1/systemone protocol as Jev. Setting
# these does not switch the model unless AUDIENCE_MODEL=systemone.
SYSTEMONE_BASE_URL=
SYSTEMONE_MODEL=clef-flash
SYSTEMONE_API_TOKEN=

# Vercel AI Gateway key, for Jev's audience scoring when no self-hosted model
# is configured or it can't be reached. Create one at Vercel dashboard > AI
# Gateway > API Keys. Jev isn't on the free tier: the key's team needs purchased
# AI Gateway Credits. Without either, audience scoring falls back to keyword
# matching and the Customers tab says so. Not needed on a Vercel deployment,
# which authenticates with its OIDC token.
AI_GATEWAY_API_KEY=

# OpenAI API key, for live competitor research with web search and page reading.
# Missing or rejected credentials leave competition coverage unknown.
OPENAI_API_KEY=

# Geoapify key, for placing campaign addresses and landmarks on the map.
# Location lookup runs on the server; the key is never sent to the browser.
GEOAPIFY_API_KEY=
