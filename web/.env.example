# Copy to .env.local and fill in. .env.local is ignored by Git.

# Vercel AI Gateway key, for Jev's audience scoring.
# Create one at Vercel dashboard > AI Gateway > API Keys. Jev isn't on
# the free tier: the key's team needs purchased AI Gateway Credits. Without it,
# audience scoring falls back to keyword matching and the Customers tab says
# so. Not needed on a Vercel deployment, which authenticates with its OIDC token.
AI_GATEWAY_API_KEY=

# OpenAI API key, for live competitor research with web search and page reading.
# Missing or rejected credentials leave competition coverage unknown.
OPENAI_API_KEY=

# Geoapify key, for placing campaign addresses and landmarks on the map.
# Location lookup runs on the server; the key is never sent to the browser.
GEOAPIFY_API_KEY=
